{
  "name": "h10-voxel-citybuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Andrea Aita (Noeinkan)",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "prestart": "node scripts/free-port.mjs",
    "start": "vite",
    "predev": "node scripts/free-port.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "docs:merge": "node scripts/docs-merge.mjs",
    "locate": "node scripts/project-locate.mjs",
    "test": "vitest run --reporter=dot",
    "test:changed": "vitest run --reporter=dot --changed",
    "test:related": "vitest related --run --reporter=dot",
    "test:watch": "vitest",
    "test:locate": "node --test scripts/project-locate.test.ts",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
